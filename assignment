#include <iostream>
#include <iomanip>
using namespace std;

int main()
{
    char names[5][20];
    int marks[5][3];
    int totals[5];
    double averages[5];

    for (int i = 0; i < 5; i++)
    {
        cout << "Enter student name: ";
        cin.getline(names[i], 20);

        totals[i] = 0;

        for (int j = 0; j < 3; j++)
        {
            cout << "Enter mark " << j + 1 << ": ";
            cin >> marks[i][j];

            totals[i] += marks[i][j];
        }

        averages[i] = totals[i] / 3.0;
        cin.ignore();
    }

    int top = 0;

    for (int i = 0; i < 5; i++)
    {
        if (totals[i] > totals[top])
        {
            top = i;
        }
    }

    cout << "\n";

    cout << left
         << setw(15) << "Name"
         << setw(8) << "M1"
         << setw(8) << "M2"
         << setw(8) << "M3"
         << setw(10) << "Total"
         << setw(10) << "Avg" << endl;

    cout << fixed << setprecision(1);

    for (int i = 0; i < 5; i++)
    {
        cout << left
             << setw(15) << names[i]
             << setw(8) << marks[i][0]
             << setw(8) << marks[i][1]
             << setw(8) << marks[i][2]
             << setw(10) << totals[i]
             << setw(10) << averages[i] << endl;
    }

    cout << "\nTop student: " << names[top] << endl;

    return 0;
}
